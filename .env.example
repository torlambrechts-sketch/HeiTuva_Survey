# Supabase — values for the linked project live in .env.local (gitignored).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses every RLS policy — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The origin the respondent link is built on: the invitation body contains
# <NEXT_PUBLIC_APP_URL>/s/<token> and nothing else identifies the survey.
#
# READ IN THREE PLACES AND DECLARED IN NONE, until now — scripts/mail-worker.ts,
# scripts/mail-smoke.ts and supabase/functions/mail-worker. That is why a
# deployment could hold every mail credential and still have no origin: nothing
# listed it as required. In production it must ALSO be set as a Supabase Edge
# Function secret, because the worker that sends runs there and not on Vercel.
NEXT_PUBLIC_APP_URL=
