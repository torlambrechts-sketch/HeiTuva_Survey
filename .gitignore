# dependencies
node_modules/

# env / secrets
.env
.env.*
!.env.example

# next.js
.next/
out/

# vercel
.vercel

# supabase
supabase/.temp/
supabase/.branches/

# claude code local settings — records approved commands verbatim,
# which can include tokens. never commit.
.claude/settings.local.json

# misc
.DS_Store
*.log

# next.js build output
/.next/
next-env.d.ts
*.tsbuildinfo

# verification artifacts — captures are regenerated per run.
# artifacts/reference/ IS committed: it is the design baseline.
artifacts/*
!artifacts/reference/
artifacts/.cdn-cache/
test-results/
playwright-report/
.mfa-secrets.json
