# dependencies
node_modules/

# env / secrets
.env
.env.*
!.env.example

# next.js
.next/
out/

# vercel
.vercel

# supabase
supabase/.temp/
supabase/.branches/

# claude code local settings — records approved commands verbatim,
# which can include tokens. never commit.
.claude/settings.local.json

# misc
.DS_Store
*.log

# next.js build output
/.next/
next-env.d.ts
*.tsbuildinfo

# verification artifacts — captures are regenerated per run.
# ALL FOUR reference sets ARE committed: they are the design baselines, one
# per handoff (DECISIONS Q18, extended by Q52). artifacts/reference/ is the
# first bundle, the baseline Phases 1-7 were built against; reference-v1/ is
# the second, the reference for screens a v1 phase built and no v2 phase
# touches; reference-v2/ is the third, the reference for screens v2 built and
# no v3 phase touches AND the only set holding splash and Bruksomrader, which
# v3 did not re-issue; reference-v3/ is the fourth, the target for every screen
# a v3 phase touches.
# Which surface is judged against which: docs/v2/00-diff.md section 0.3.
# An added bundle needs a line here as well as one in scripts/verify/
# reference.ts — without it the set renders and is silently never committed.
artifacts/*
!artifacts/reference/
!artifacts/reference-v1/
!artifacts/reference-v2/
!artifacts/reference-v3/
!artifacts/reference-v4/
!artifacts/reference-v5/
!artifacts/reference-v6/
!artifacts/reference-v7/
!artifacts/reference-v8/
artifacts/.cdn-cache/
test-results/
playwright-report/
.mfa-secrets.json

# generated by npm run edge:bundle — a deploy payload, not source
.edge-bundle/

# F2 — the fidelity composites are DERIVED from two sets that are already
# committed, and there are 28 large PNGs of them, so they stay local and
# regenerable (`npm run verify:fidelity`). The REPORT is committed, because the
# durable finding is which screens have no app capture to compare against — and
# that is a fact about the capture manifest, not about a picture.
!artifacts/fidelity/
artifacts/fidelity/*
!artifacts/fidelity/00-report.md
